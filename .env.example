# Copier en .env et adapter. Consommé par docker-compose.yml.

POSTGRES_USER=agilometre
POSTGRES_PASSWORD=agilometre
POSTGRES_DB=agilometre
# Port hôte publié par docker-compose (5432 par défaut peut déjà être pris par un autre service local)
POSTGRES_PORT=5433

JWT_SECRET=change-me-en-production

# SMTP du client (point de dépendance à obtenir tôt dans un projet client, cf. PRD §10).
SMTP_HOST=smtp.client.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Agilomètre <no-reply@client.example>"
