# Copier en .env et adapter. Consommé par docker-compose.yml.

POSTGRES_USER=agilometre
POSTGRES_PASSWORD=agilometre
POSTGRES_DB=agilometre
# Port hôte publié par docker-compose (5432 par défaut peut déjà être pris par un autre service local)
POSTGRES_PORT=5433

# Base Postgres dédiée aux tests e2e backend (pnpm dev:db:test), isolée de la base de dev
# ci-dessus pour que `pnpm --filter backend run test:e2e` ne touche jamais aux données de
# `pnpm dev`. Valeurs par défaut déjà appliquées dans docker-compose.yml, rien à changer ici
# sauf conflit de port local.
# POSTGRES_TEST_USER=agilometre
# POSTGRES_TEST_PASSWORD=agilometre
# POSTGRES_TEST_DB=agilometre_test
# POSTGRES_TEST_PORT=5434

JWT_SECRET=change-me-en-production
# Durée de session de connexion, à renouvellement glissant (doc/spec/annexes/gestion-des-droits.md).
SESSION_DUREE_HEURES=12

# URL publique de cette instance — sert à construire les liens des emails (invitation,
# réinitialisation de mot de passe), jamais déduite du header Host de la requête entrante.
APP_URL=http://localhost:4200

# SMTP du client en production (point de dépendance à obtenir tôt dans un projet client, cf. PRD
# §10) — remplacer par le relais du client avant déploiement. Valeurs ci-dessous : Mailpit local
# (démarré par `pnpm dev:db`, webmail sur http://localhost:8025), capture tout, ne laisse rien
# sortir — indispensable pour tester des invitations/réinitialisations sans arroser de vraies
# adresses (doc/spec/annexes/gestion-des-droits.md).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Agilomètre <no-reply@agilometre.local>"
