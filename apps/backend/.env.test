# Base Postgres dédiée aux tests e2e (pnpm dev:db:test, port 5434) — isolée de apps/backend/.env
# pour que `pnpm --filter backend run test:e2e` ne touche jamais à la base de `pnpm dev`.
# Aucune valeur ici n'est un secret réel.

DATABASE_URL="postgresql://agilometre:agilometre@localhost:5434/agilometre_test?schema=public"

PORT=3000
JWT_SECRET="test-secret"
SESSION_TOKEN_TTL_HOURS=12
POULS_TOKEN_TTL_HOURS=72

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Agilomètre <no-reply@agilometre.local>"
