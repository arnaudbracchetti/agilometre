# Base Postgres dédiée aux tests e2e (pnpm dev:db:test, port 5434) — isolée de apps/backend/.env
# pour que `pnpm --filter backend run test:e2e` ne touche jamais à la base de `pnpm dev`.
# Aucune valeur ici n'est un secret réel.

DATABASE_URL="postgresql://agilometre:agilometre@localhost:5434/agilometre_test?schema=public"

PORT=3000
JWT_SECRET="test-secret"
SESSION_TOKEN_TTL_HOURS=12
POULS_TOKEN_TTL_HOURS=72
# Fixée explicitement : sans cette ligne, ConfigModule retombe sur apps/backend/.env (non
# versionné) pour toute variable absente d'ici, rendant les e2e dépendantes du `.env` local du
# poste (cf. `SCORING_DUREE_PERIODE_MOIS` qui y vaut parfois autre chose que le défaut).
SCORING_DUREE_PERIODE_MOIS=3
SESSION_DUREE_HEURES=12

APP_URL="http://localhost:4200"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Agilomètre <no-reply@agilometre.local>"
