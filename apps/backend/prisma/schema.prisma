// Squelette de modèle de domaine (PRD §4). À affiner au fil de l'implémentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  MEMBRE
  MANAGER
  DIRECTION
}

enum OrigineReponse {
  SESSION
  POULS
}

enum StatutSession {
  PREPAREE
  OUVERTE
  CLOTUREE
}

// --- Référentiel : ré-importable dans le temps via Clé stable (ADR 0004) ---

model Referentiel {
  id            String   @id @default("singleton")
  derniereMajLe DateTime
}

model Theme {
  id        String     @id
  libelle   String
  ordre     Int
  retireLe  DateTime?
  questions Question[]
}

model Question {
  id        String    @id
  libelle   String
  ordre     Int
  theme     Theme     @relation(fields: [themeId], references: [id])
  themeId   String
  retireeLe DateTime?
  options   Option[]
}

model Option {
  id         String   @id @default(uuid())
  libelle    String
  niveau     Int // 1 à 4
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

// --- Organisation : entités / BU > équipes > membres (§4) ---

// Unicité de `nom` (insensible à la casse) garantie par un index fonctionnel sur LOWER(nom),
// ajouté par migration SQL brute (non représentable ici, pas d'index d'expression natif) —
// voir la migration entite_nom_unique_ci et docs/design/agregat-organisation.md.
model Entite {
  id      String   @id @default(uuid())
  nom     String
  equipes Equipe[]
}

model Equipe {
  id        String          @id @default(uuid())
  nom       String
  entite    Entite          @relation(fields: [entiteId], references: [id])
  entiteId  String
  membres   Membre[]
  sessions  Session[]
  campagnes CampagnePouls[]
}

// Un Membre d'une Équipe, sans compte de connexion obligatoire (agrégat Organisation,
// docs/design/agregat-organisation.md). `email` n'est volontairement pas unique globalement :
// une même personne peut apparaître comme Membre de plusieurs Équipes. `prenom` reste `null`
// tant qu'aucun compte n'est lié (nom/email suffisent alors à l'identifier à l'écran) ; renseigné par
// propagation descendante une fois lié (#62). `utilisateurId` référence un Utilisateur `Rôle=MEMBRE`
// une fois rattaché — automatiquement par email, à la création du compte ou à l'ajout d'un Membre à une Équipe
// (doc/spec/annexes/gestion-des-droits.md, "Rattachement automatique"), jamais rejoué ensuite.
model Membre {
  id            String       @id @default(uuid())
  nom           String
  prenom        String?
  email         String
  equipe        Equipe       @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  equipeId      String
  // `onDelete: SetNull` documente l'intention plutôt que de dépendre du défaut implicite de Prisma :
  // un Utilisateur ne se supprime jamais cette itération (désactivation seulement), mais si ce
  // devait changer, le Membre doit survivre, juste redevenir éditable.
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  utilisateurId String?

  @@index([utilisateurId])
}

// Compte de connexion (issue #59, doc/spec/annexes/gestion-des-droits.md). Unicité de `email`
// (insensible à la casse) garantie par un index fonctionnel sur LOWER(email), ajouté par une
// migration SQL brute (même limitation que Entite.nom) — voir la migration
// utilisateur_email_unique_ci et docs/design/agregat-politique-des-droits.md.
model Utilisateur {
  id             String         @id @default(uuid())
  email          String
  prenom         String
  nom            String
  motDePasseHash String
  actif          Boolean        @default(true)
  role           Role
  jetons         JetonCompte[]
  habilitations  Habilitation[]
  membres        Membre[]
}

// Entité enfant de Utilisateur (issue #61, docs/design/agregat-organisation.md §1) : borne le
// périmètre d'une Direction à une Entité, ou (invariant porté, non exploité cette itération) d'un
// Manager d'équipe à une Équipe. Exactement un des deux champs est renseigné — invariant porté par
// `Utilisateur.ajouterHabilitation()`, pas par une contrainte de base. Pas de relation Prisma vers
// Entite/Equipe (mêmes bounded contexts séparés qu'ADR-0005, même pattern que
// Membre.utilisateurId) : `onDelete: Cascade` ne joue que côté Utilisateur.
model Habilitation {
  id            String      @id @default(uuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  entiteId      String?
  equipeId      String?
}

// Jeton de compte (CONTEXT.md, issue #60) : usage unique, 7 jours, sert à la fois l'invitation
// initiale et la réinitialisation de mot de passe — un seul mécanisme, pas de fonction de renvoi
// distincte. Distinct de JetonSession (anonyme, portée toute la Session) et de
// Sollicitation.tokenHash (Pouls, non implémenté). `tokenHash` : seul le hash est persisté, jamais
// le jeton en clair (même précédent que Sollicitation.tokenHash).
model JetonCompte {
  id            String      @id @default(uuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  tokenHash     String      @unique
  creeLe        DateTime    @default(now())
  expireLe      DateTime
  consommeLe    DateTime?
}

// --- Session animée (§4, §7) ---

// Bibliothèque globale de Sélections de Questions nommées et réutilisables (ADR-0008), sans
// rattachement à une Équipe. Librement supprimable, y compris déjà utilisée par une ou plusieurs
// Sessions (ADR-0009) — d'où l'absence de toute relation Prisma vers Session.
model ModeleCollecte {
  id        String          @id @default(uuid())
  nom       String
  updatedAt DateTime        @updatedAt
  items     SelectionItem[]
}

// `questionId` reste une chaîne simple (pas de relation Prisma) : le Référentiel et Session sont
// des bounded contexts séparés dans ce schéma, même convention que TourDeVote.questionId /
// Sollicitation.questionId.
model SelectionItem {
  id               String         @id @default(uuid())
  modeleCollecte   ModeleCollecte @relation(fields: [modeleCollecteId], references: [id], onDelete: Cascade)
  modeleCollecteId String
  questionId       String
  ordre            Int

  @@index([modeleCollecteId])
}

// `modeleCollecteId` est une chaîne simple obligatoire (pas de relation Prisma vers ModeleCollecte) :
// la Sélection est copiée figée à la création (ADR-0009), le champ ne sert qu'à la traçabilité —
// aucune contrainte d'intégrité forte, la suppression du Modèle source n'a aucun effet ici.
// `code` : unique parmi les Sessions OUVERTE, via un index unique partiel ajouté à la main dans la
// migration (non représentable ici — même limitation que Entite.nom, voir entite_nom_unique_ci).
// Pas de colonne verrouillee : dérivée de statut (Session.estVerrouillee()), jamais son propre état.
model Session {
  id               String                  @id @default(uuid())
  equipe           Equipe                  @relation(fields: [equipeId], references: [id])
  equipeId         String
  date             DateTime                @default(now())
  statut           StatutSession           @default(PREPAREE)
  code             String?
  ouvertureLe      DateTime?
  indexCourant     Int                     @default(-1)
  modeleCollecteId String
  items            SessionSelectionItem[]
  questionsSautees SessionQuestionSautee[]
  tours            TourDeVote[]
  jetons           JetonSession[]
}

// Copie figée de la Sélection du Modèle au moment de la création (ADR-0009) — même pattern que
// SelectionItem, `questionId` en chaîne simple (Référentiel et Session sont des bounded contexts
// séparés).
model SessionSelectionItem {
  id         String  @id @default(uuid())
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  questionId String
  ordre      Int

  @@index([sessionId])
}

// Set de Questions sautées (pas d'ordre, contrairement à SessionSelectionItem) — carte #32.
model SessionQuestionSautee {
  id         String  @id @default(uuid())
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  questionId String

  @@unique([sessionId, questionId])
}

// Index sur (sessionId, clotureLe) : sert directement trouverOuvertPour(sessionId), le seul accès
// chaud pour l'instant (docs/design/agregat-tour-de-vote.md §4). Pas d'@@unique sur
// (sessionId, questionId, numero) : l'invariant "numero strictement croissant" est déjà porté par
// l'agrégat TourDeVote lui-même (creer), et la création d'un Tour est un geste humain, séquentiel,
// mono-coach — contrairement à Session.code où la concurrence entre coachs justifie l'index partiel.
model TourDeVote {
  id             String          @id @default(uuid())
  session        Session         @relation(fields: [sessionId], references: [id])
  sessionId      String
  questionId     String
  numero         Int
  ouvertLe       DateTime        @default(now())
  clotureLe      DateTime?
  reponses       Reponse[]
  participations Participation[]

  @@index([sessionId, clotureLe])
}

// Émis uniquement pour une Session OUVERTE — vérifié par JetonSessionRepository.emettre via un
// INSERT conditionnel atomique, jamais par ce modèle (docs/design/agregat-tour-de-vote.md §2).
// Valable toute la durée de la Session, jamais renouvelé par Tour (ADR-0011).
// remplaceLe : renseigné quand le device rejoint explicitement une autre Session ("Rejoindre une
// autre séance") — seul cas qui sort ce Jeton du compteur de sa Session d'origine (addendum
// ADR-0011) ; jamais renseigné pour une déconnexion passive (onglet fermé, inactivité), qui reste
// sans effet sur le compteur.
model JetonSession {
  id             String          @id @default(uuid())
  session        Session         @relation(fields: [sessionId], references: [id])
  sessionId      String
  creeLe         DateTime        @default(now())
  remplaceLe     DateTime?
  participations Participation[]
}

// Bookkeeping éphémère : détecte un revote au sein d'un Tour ouvert (une seule Participation par
// Jeton et par Tour, garantie par la clé primaire composite ci-dessous, pas de colonne id
// surnuméraire — reflète tel quel Participation(tourId, jetonId, reponseId) de l'issue #33).
// Purgée intégralement à la clôture du Tour (docs/design/agregat-tour-de-vote.md §2) — ne survit
// jamais à son Tour ; Reponse, elle, n'est jamais supprimée à cette occasion.
model Participation {
  tour      TourDeVote   @relation(fields: [tourId], references: [id])
  tourId    String
  jeton     JetonSession @relation(fields: [jetonId], references: [id])
  jetonId   String
  reponse   Reponse      @relation(fields: [reponseId], references: [id])
  reponseId String       @unique

  @@id([tourId, jetonId])
}

// --- Campagne de pouls (§4, §8) ---

model CampagnePouls {
  id                String          @id @default(uuid())
  equipe            Equipe          @relation(fields: [equipeId], references: [id])
  equipeId          String
  rythmeJours       Int
  questionsParEnvoi Int             @default(1)
  dateFin           DateTime?
  sollicitations    Sollicitation[]
}

// Trace qui a été sollicité, sur quelle question, sans jamais lier à la réponse (§5).
model Sollicitation {
  id         String        @id @default(uuid())
  campagne   CampagnePouls @relation(fields: [campagneId], references: [id])
  campagneId String
  membreId   String
  questionId String
  tokenHash  String        @unique
  envoyeeLe  DateTime      @default(now())
  expireLe   DateTime
  honoreeLe  DateTime?
}

// --- Réponse anonyme (§4, §5) : aucun lien vers l'identité du répondant ---

model Reponse {
  id            String         @id @default(uuid())
  questionId    String
  niveau        Int // 1 à 4
  equipeId      String
  horodatage    DateTime       @default(now())
  origine       OrigineReponse
  tour          TourDeVote?    @relation(fields: [tourId], references: [id])
  tourId        String?
  participation Participation?
}
