// Squelette de modèle de domaine (PRD §4). À affiner au fil de l'implémentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  MEMBRE
  MANAGER
  DIRECTION
}

enum OrigineReponse {
  SESSION
  POULS
}

enum StatutSession {
  OUVERTE
  CLOTUREE
}

// --- Référentiel : ré-importable dans le temps via Clé stable (ADR 0004) ---

model Referentiel {
  id            String   @id @default("singleton")
  derniereMajLe DateTime
}

model Theme {
  id        String     @id
  libelle   String
  ordre     Int
  retireLe  DateTime?
  questions Question[]
}

model Question {
  id        String    @id
  libelle   String
  ordre     Int
  theme     Theme     @relation(fields: [themeId], references: [id])
  themeId   String
  retireeLe DateTime?
  options   Option[]
}

model Option {
  id         String   @id @default(uuid())
  libelle    String
  niveau     Int // 1 à 4
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

// --- Organisation : entités / BU > équipes > membres (§4) ---

// Unicité de `nom` (insensible à la casse) garantie par un index fonctionnel sur LOWER(nom),
// ajouté par migration SQL brute (non représentable ici, pas d'index d'expression natif) —
// voir la migration entite_nom_unique_ci et docs/design/agregat-organisation.md.
model Entite {
  id      String   @id @default(uuid())
  nom     String
  equipes Equipe[]
}

model Equipe {
  id        String          @id @default(uuid())
  nom       String
  entite    Entite          @relation(fields: [entiteId], references: [id])
  entiteId  String
  membres   Membre[]
  sessions  Session[]
  campagnes CampagnePouls[]
}

// Roster d'une Équipe, sans compte de connexion obligatoire (agrégat Organisation,
// docs/design/agregat-organisation.md). `email` n'est volontairement pas unique globalement :
// une même personne peut apparaître dans plusieurs rosters. `utilisateurId` référence par id un
// futur Utilisateur (pas de relation Prisma : ce modèle n'existe pas encore, voir #21/#23) — même
// pattern que Sollicitation.membreId.
model Membre {
  id            String  @id @default(uuid())
  nom           String
  email         String
  equipe        Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  equipeId      String
  utilisateurId String?
}

// --- Session animée (§4, §7) ---

// Bibliothèque globale de Sélections de Questions nommées et réutilisables (ADR-0008), sans
// rattachement à une Équipe. Librement supprimable, y compris déjà utilisée par une ou plusieurs
// Sessions (ADR-0009) — d'où l'absence de toute relation Prisma vers Session.
model ModeleSession {
  id        String          @id @default(uuid())
  nom       String
  updatedAt DateTime        @updatedAt
  items     SelectionItem[]
}

// `questionId` reste une chaîne simple (pas de relation Prisma) : le Référentiel et Session sont
// des bounded contexts séparés dans ce schéma, même convention que TourDeVote.questionId /
// Sollicitation.questionId.
model SelectionItem {
  id              String        @id @default(uuid())
  modeleSession   ModeleSession @relation(fields: [modeleSessionId], references: [id], onDelete: Cascade)
  modeleSessionId String
  questionId      String
  ordre           Int

  @@index([modeleSessionId])
}

// `modeleSessionId` est une chaîne simple obligatoire (pas de relation Prisma vers ModeleSession) :
// la Sélection est copiée figée à la création (ADR-0009), le champ ne sert qu'à la traçabilité —
// aucune contrainte d'intégrité forte, la suppression du Modèle source n'a aucun effet ici.
model Session {
  id              String                 @id @default(uuid())
  equipe          Equipe                 @relation(fields: [equipeId], references: [id])
  equipeId        String
  date            DateTime               @default(now())
  statut          StatutSession          @default(OUVERTE)
  modeleSessionId String
  verrouillee     Boolean                @default(false)
  items           SessionSelectionItem[]
  tours           TourDeVote[]
}

// Copie figée de la Sélection du Modèle au moment de la création (ADR-0009) — même pattern que
// SelectionItem, `questionId` en chaîne simple (Référentiel et Session sont des bounded contexts
// séparés).
model SessionSelectionItem {
  id         String  @id @default(uuid())
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  questionId String
  ordre      Int

  @@index([sessionId])
}

model TourDeVote {
  id         String    @id @default(uuid())
  session    Session   @relation(fields: [sessionId], references: [id])
  sessionId  String
  questionId String
  numero     Int
  ouvertLe   DateTime  @default(now())
  clotureLe  DateTime?
  reponses   Reponse[]
}

// --- Campagne de pouls (§4, §8) ---

model CampagnePouls {
  id                String          @id @default(uuid())
  equipe            Equipe          @relation(fields: [equipeId], references: [id])
  equipeId          String
  rythmeJours       Int
  questionsParEnvoi Int             @default(1)
  dateFin           DateTime?
  sollicitations    Sollicitation[]
}

// Trace qui a été sollicité, sur quelle question, sans jamais lier à la réponse (§5).
model Sollicitation {
  id         String        @id @default(uuid())
  campagne   CampagnePouls @relation(fields: [campagneId], references: [id])
  campagneId String
  membreId   String
  questionId String
  tokenHash  String        @unique
  envoyeeLe  DateTime      @default(now())
  expireLe   DateTime
  honoreeLe  DateTime?
}

// --- Réponse anonyme (§4, §5) : aucun lien vers l'identité du répondant ---

model Reponse {
  id         String         @id @default(uuid())
  questionId String
  niveau     Int // 1 à 4
  equipeId   String
  horodatage DateTime       @default(now())
  origine    OrigineReponse
  tour       TourDeVote?    @relation(fields: [tourId], references: [id])
  tourId     String?
}
