# Copier vers /opt/agilometre/.env sur le serveur de production (jamais committé) et adapter.
# Consommé par docker-compose.prod.yml.

PUBLIC_DOMAIN=agilometre.nekbet.fr
IMAGE_TAG=v0.1.0

POSTGRES_USER=agilometre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agilometre

JWT_SECRET=change-me-en-production

# SMTP du client (point de dépendance à obtenir tôt dans un projet client, cf. PRD §10).
SMTP_HOST=smtp.client.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Agilomètre <no-reply@client.example>"
